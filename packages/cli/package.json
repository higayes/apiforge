{
  "name": "@apiforge-tools/apiforge-cli",
  "version": "0.1.0",
  "description": "APIFORGE CLI — API testing, validation, performance testing and security analysis. Test smarter. Ship with confidence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "apiforge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "api",
    "api-testing",
    "cli",
    "load-testing",
    "performance",
    "security",
    "openapi",
    "contract-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higayes/apiforge.git"
  },
  "homepage": "https://github.com/higayes/apiforge#readme",
  "bugs": {
    "url": "https://github.com/higayes/apiforge/issues"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.1.0",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apiforge/engine": "workspace:*",
    "tsup": "^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
