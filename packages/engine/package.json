{
  "name": "@apiforge/engine",
  "version": "0.1.0",
  "description": "Core engine for APIFORGE: HTTP requests, assertions, performance, security analysis and reporting.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "undici": "^7.30.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
